# ==============================================================================
# QRGIFT PLATFORM - ENVIRONMENT VARIABLES
# Copy this file to .env.local to connect your production keys
# (The platform will automatically fall back to local mock storage if keys are blank)
# ==============================================================================

# 1. Supabase PostgreSQL & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Mercado Pago (Local / Latam Payments - Checkout Pro)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-mercadopago-access-token

# 3. Stripe (International Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# 4. App Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
